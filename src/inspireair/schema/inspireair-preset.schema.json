{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oliveval17-max/inspireair/schema/inspireair-preset.schema.json",
  "title": "InspireAir preset",
  "description": "Preset de tranche de console X-Air, validé par « inspireair validate ».",
  "type": "object",
  "required": ["instrument", "element", "style"],
  "additionalProperties": false,
  "properties": {
    "instrument": { "type": "string", "minLength": 1 },
    "element": { "type": "string", "minLength": 1 },
    "style": { "type": "string", "minLength": 1 },
    "variant": { "type": ["string", "null"], "minLength": 1 },
    "tessiture": { "enum": ["Homme", "Femme", null] },
    "notes": { "type": ["string", "null"] },
    "author": { "type": ["string", "null"] },
    "version": { "type": "string" },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 12 },
        "color": { "type": "integer", "minimum": 0, "maximum": 15 }
      }
    },
    "hpf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": { "type": "boolean" },
        "freq": { "type": "number", "minimum": 20, "maximum": 400 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": { "type": "boolean" },
        "thr": { "type": "number", "minimum": -80, "maximum": 0 },
        "range": { "type": "number", "minimum": 3, "maximum": 60 },
        "attack": { "type": "number", "minimum": 0, "maximum": 120 },
        "hold": { "type": "number", "minimum": 0.02, "maximum": 2000 },
        "release": { "type": "number", "minimum": 5, "maximum": 4000 }
      }
    },
    "eq": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["band", "type", "freq", "gain", "q"],
        "properties": {
          "band": { "type": "integer", "minimum": 1, "maximum": 4 },
          "type": {
            "description": "Types X-Air ; VEQ4/VEQ6/HPF1/LPF1 sont acceptés en alias.",
            "enum": ["LCut", "LShv", "PEQ", "VEQ", "HShv", "HCut", "VEQ4", "VEQ6", "HPF1", "LPF1"]
          },
          "freq": { "type": "number", "minimum": 20, "maximum": 20000 },
          "gain": { "type": "number", "minimum": -15, "maximum": 15 },
          "q": { "type": "number", "minimum": 0.1, "maximum": 10 }
        }
      }
    },
    "comp": {
      "type": "object",
      "additionalProperties": false,
      "description": "Le compresseur X-Air est le nœud /dyn ; le ratio suit ses crans fixes.",
      "properties": {
        "on": { "type": "boolean" },
        "thr": { "type": "number", "minimum": -60, "maximum": 0 },
        "ratio": { "enum": [1.1, 1.3, 1.5, 2.0, 2.5, 3.0, 4.0, 5.0, 7.0, 10, 20, 100] },
        "attack": { "type": "number", "minimum": 0, "maximum": 120 },
        "hold": { "type": "number", "minimum": 0.02, "maximum": 2000 },
        "release": { "type": "number", "minimum": 5, "maximum": 4000 },
        "knee": { "type": "number", "minimum": 0, "maximum": 5 },
        "mgain": { "type": "number", "minimum": 0, "maximum": 24 },
        "mix": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
